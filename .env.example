# continente-mcp environment variables
# Copy this to a private env file, for example:
#   ~/.continente/credentials.env
#
# Keep the real file outside your repo, chmod 600, and never commit it.

# Required for automatic login.
# CONTINENTE_EMAIL=you@example.com
# CONTINENTE_PASSWORD=your-password

# Optional: use a different private env file. This one cannot go in the file
# itself; set it in your MCP client's server "env" instead.
# CONTINENTE_ENV_PATH=/absolute/path/to/credentials.env

# Set to false only for local debugging, so you can watch the login browser.
# CONTINENTE_LOGIN_HEADLESS=true

# Path where cookies are stored (default: ~/.continente/cookies.json)
# Cookies are an internal session cache; you usually do not need to edit this.
# CONTINENTE_COOKIES_PATH=/absolute/path/to/cookies.json

# If you run the MCP server on a second machine and sync cookies via a shared
# folder (e.g. Obsidian vault, Syncthing, Dropbox), set this to the shared path
# for automatic login to also write cookies there. These cookies give access
# to your account: only use a private folder you control.
# CONTINENTE_VAULT_COOKIE_PATH=/path/to/shared/folder/cookies.json

# Override the state directory (preferences and default cookies)
# CONTINENTE_STATE_DIR=/absolute/path/to/state
